{
  "expo": {
    "name": "MedFind",
    "slug": "medfind",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "medfind",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FCF8ED"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MedFind uses your location to show medicines available near you."
      }
    },
    "android": {
      "package": "com.bmsce.medfind",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FCF8ED"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MedFind uses your location to show medicines available near you."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#87A96B"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization"
    ]
  }
}
